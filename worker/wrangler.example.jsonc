{
  // Cloudflare Worker configuration template for the Surco API (Chirp + Launcher + veChirp).
  // Copy to wrangler.jsonc and fill in your D1 database_id and custom domain routes.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surco",
  "compatibility_date": "2026-06-30",
  "main": "src/index.ts",
  "assets": {
    "directory": "../web/dist",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "CHIRP_DB",
      "database_name": "chirp",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LAUNCHER_IMAGES",
      "bucket_name": "launcher-images"
    }
  ],
  "ratelimits": [
    { "name": "ZEROX_LIMITER", "namespace_id": "1", "simple": { "limit": 30, "period": 60 } },
    { "name": "RPC_LIMITER", "namespace_id": "3", "simple": { "limit": 600, "period": 60 } },
    { "name": "IMG_LIMITER", "namespace_id": "4", "simple": { "limit": 5, "period": 60 } }
  ],
  "triggers": {
    "crons": ["*/10 * * * *", "5-59/10 * * * *"]
  },
  // Peg & launch watch posts: off | dry | on (requires X_* secrets when "on").
  "vars": {
    "X_POSTS": "off"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "surcofi.com", "custom_domain": true },
    { "pattern": "www.surcofi.com", "custom_domain": true }
  ]
}
